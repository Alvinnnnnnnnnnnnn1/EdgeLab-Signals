<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.edgelab.signals.worker</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PATH/TO/NODE24</string>
    <string>--env-file-if-exists=.env.local</string><string>--import</string><string>tsx</string><string>src/cli.ts</string><string>worker</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/asan/EdgeLab-Signals</string>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/asan/EdgeLab-Signals/.local/worker.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/asan/EdgeLab-Signals/.local/worker.stderr.log</string>
</dict></plist>

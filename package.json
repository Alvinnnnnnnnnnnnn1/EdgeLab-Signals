{
  "name": "edgelab-signals",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "signals": "node --env-file-if-exists=.env.local --import tsx src/cli.ts",
    "demo": "node --env-file-if-exists=.env.local --import tsx src/cli.ts demo",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/cli.ts worker",
    "audit": "node --env-file-if-exists=.env.local --import tsx src/cli.ts audit",
    "research": "node --env-file-if-exists=.env.local --import tsx src/research/cli.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
